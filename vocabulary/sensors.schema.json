{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EOMAP sensors",
  "description": "Sensor id \u2192 definition with STAC common metadata. Aliases are other spellings in use.",
  "type": "object",
  "propertyNames": {
    "pattern": "^[a-z0-9]+$"
  },
  "additionalProperties": {
    "type": "object",
    "required": [
      "title",
      "type"
    ],
    "additionalProperties": false,
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1
      },
      "type": {
        "enum": [
          "optical",
          "radar",
          "lidar",
          "dataset",
          "model",
          "uav",
          "multi"
        ]
      },
      "constellation": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "platform": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "instruments": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9+-]+$"
        }
      },
      "aliases": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
